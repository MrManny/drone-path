  },
  "dependencies": {
    "@types/leaflet": "~1.9.22",
    "drone-path-core": "~0.13.0",
    "leaflet": "~1.9.4",
    "p-queue": "~10.0.0",
    "playwright-core": "~1.65.0",
    "zod": "~4.6.7"
