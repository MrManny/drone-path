{
  "name": "drone-path-engine",
  "version": "1.2.0",
  "description": "Plan and render flight-path map overlays from drone telemetry.",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/clean-package-dist.mjs && tsc -b"
  },
  "author": "Manuel Warum",
  "license": "MIT",
  "homepage": "https://www.dronepath.dev",
  "keywords": [
    "dji",
    "drone",
    "telemetry",
    "gpx",
    "srt",
    "kml",
    "mcp",
    "davinci-resolve"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrManny/drone-path.git",
    "directory": "packages/engine"
  },
  "dependencies": {
    "@types/leaflet": "~1.9.22",
    "drone-path-core": "~1.2.0",
    "leaflet": "~1.9.4",
    "p-queue": "~10.0.0",
    "playwright-core": "~1.65.0",
    "zod": "~4.6.7"
  }
}
