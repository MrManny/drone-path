{
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "name": "drone-path-workspace",
  "workspaces": [
    "packages/core",
    "packages/archive",
    "packages/engine",
    "packages/cli",
    "apps/desktop",
    "packages/tooling"
  ],
  "scripts": {
    "app": "npm run start --workspace drone-path-desktop --",
    "app:dev": "node scripts/build.mjs prep && npm run dev --workspace drone-path-desktop",
    "app:pack": "npm run pack --workspace drone-path-desktop --",
    "build": "node scripts/build.mjs",
    "build:cli": "tsc -b packages/cli",
    "build:ui": "npm run build:ui --workspace drone-path-desktop",
    "clean": "node scripts/build.mjs clean",
    "docs:reference": "tsc -b packages/tooling && node packages/tooling/dist/manual/reference.js",
    "docs:schema": "tsc -b packages/tooling && node packages/tooling/dist/telemetry-json-schema.js",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "test": "node scripts/build.mjs prep && tsc --noEmit -p tsconfig.tests.json && vitest run",
    "lint": "node scripts/build.mjs prep && eslint ."
  },
  "devDependencies": {
    "@changesets/cli": "~3.0.3",
    "@eslint/js": "~10.0.1",
    "@next/eslint-plugin-next": "~16.4.6",
    "@types/node": "~24.19.2",
    "eslint": "~10.15.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.74.0",
    "vitest": "~5.1.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "ffmpeg-ffprobe-static@7.1.0-rc.1": true
  }
}
