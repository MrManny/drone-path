{
  "name": "drone-path",
  "version": "0.8.1",
  "description": "Render flight-path map overlay videos (exactly the source frame rate and frame count) from DJI drone recordings - telemetry from the .SRT sidecar or the embedded CAM-meta (DVTM) stream.",
  "type": "module",
  "main": "app/main.mjs",
  "bin": {
    "drone-path": "bin/drone-path.mjs"
  },
  "files": [
    "app",
    "bin",
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "app": "electron app/main.mjs",
    "app:dev": "npm run build:manual && concurrently -k \"next dev ui --webpack -p 3210\" \"wait-on http://127.0.0.1:3210 && electron app/main.mjs --dev-url http://localhost:3210\"",
    "app:pack": "electron-builder --publish never",
    "build": "npm run build:manual && npm run build:ui",
    "build:cli": "tsc -p tsconfig.json",
    "build:manual": "npm run build:cli && node dist/manual/build.js",
    "build:ui": "next build ui --webpack",
    "docs:reference": "npm run build:cli && node dist/manual/reference.js",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "test": "npm run build:manual && npm run typecheck:test && vitest run",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint .",
    "prepare": "npm run build"
  },
  "keywords": [
    "dji",
    "drone",
    "telemetry",
    "srt",
    "cam-meta",
    "dvtm",
    "flight-path",
    "map",
    "video",
    "ffmpeg",
    "leaflet"
  ],
  "author": "Manuel Warum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrManny/drone-path.git"
  },
  "bugs": {
    "url": "https://github.com/MrManny/drone-path/issues"
  },
  "homepage": "https://github.com/MrManny/drone-path#readme",
  "dependencies": {
    "@opentelemetry/api": "~1.10.0",
    "@opentelemetry/exporter-trace-otlp-proto": "~0.301.0",
    "@opentelemetry/resources": "~3.1.0",
    "@opentelemetry/sdk-trace": "~3.1.0",
    "commander": "~15.0.0",
    "electron-updater": "~6.8.11",
    "leaflet": "~1.9.4",
    "playwright-core": "~1.65.0"
  },
  "optionalDependencies": {
    "ffmpeg-ffprobe-static": "~7.1.0-rc.1"
  },
  "devDependencies": {
    "@changesets/cli": "~3.0.3",
    "@eslint/js": "~10.0.1",
    "@next/eslint-plugin-next": "~16.4.3",
    "@testing-library/react": "~16.3.3",
    "@testing-library/user-event": "~14.6.8",
    "@types/node": "~24.19.2",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "concurrently": "~10.0.6",
    "electron": "~45.2.1",
    "electron-builder": "~26.18.0",
    "eslint": "~10.14.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "jsdom": "~30.1.3",
    "marked": "~18.1.3",
    "next": "~16.4.3",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.1",
    "vitest": "~5.1.0",
    "wait-on": "~9.5.1"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "ffmpeg-ffprobe-static@7.1.0-rc.1": true
  }
}
