{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "react-jsx",
    "incremental": true,
    "noEmit": true
  },
  "include": [
    "test/**/*.ts",
    "test/**/*.tsx",
    "packages/*/test/**/*.ts",
    "apps/*/test/**/*.ts",
    "apps/*/test/**/*.tsx"
  ]
}
